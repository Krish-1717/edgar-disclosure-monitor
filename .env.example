# .env.example — Copy this to .env and fill in real values
# .env is in .gitignore and will NEVER be committed to git
# .env.example IS committed — it shows teammates what keys are needed

# ============================================================
# OPENAI (for real AI chat responses in v5+)
# Get your key at: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================
# SEC EDGAR — NO KEY NEEDED (free public API)
# These URLs work directly from client-side JS, no proxy
# ============================================================
# CIK lookup:  https://www.sec.gov/files/company_tickers.json
# Submissions: https://data.sec.gov/submissions/CIK{10-digit-cik}.json
# Filing docs: https://www.sec.gov/Archives/edgar/data/{cik}/{accession}/

# ============================================================
# ORACLE CRAWLER (python -m oracle)
# SEC fair access: a descriptive User-Agent WITH a contact email is required
# (requests without one get 403). Rate is capped at 10 req/s by the client.
# ============================================================
ORACLE_USER_AGENT="FirstName LastName email@example.com"
# ORACLE_DB_PATH=data/oracle/oracle.db
# ORACLE_DATA_DIR=data/oracle/documents
# ORACLE_MAX_RPS=8
# ORACLE_FORMS=10-K,10-Q,8-K,DEF 14A,4,S-1,S-4
# ORACLE_CORS_ORIGINS=https://krish-1717.github.io,http://127.0.0.1:8766

# ============================================================
# FUTURE BACKEND (v6+)
# ============================================================
# DATABASE_URL=postgresql://localhost/edgar_monitor
# PORT=3001
# JWT_SECRET=your-jwt-secret-here
